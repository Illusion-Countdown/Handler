; Engine configuration file.
config_version=5

[application]

config/name="HANDLER"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

G="*res://scripts/game_state.gd"
Audio="*res://scripts/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/size/mode=3
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.0117647, 0.0196078, 0.0352941, 1)

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
